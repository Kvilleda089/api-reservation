// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMINISTRATOR
  ADMINISTRATOR
  COURT_MANAGER
  CLEANING_STAFF
  RECEPTIONIST
}

enum ReservationResource {
  CANCHA_1
  CANCHA_2
  SALON
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  FINALIZADA
}

model Employee {
  id            String   @id @default(uuid()) @db.Uuid
  firstName     String   @map("first_name") @db.VarChar(150)
  middleName    String   @map("middle_name") @db.VarChar(150)
  surname       String   @db.VarChar(150)
  secondSurname String   @map("second_surname") @db.VarChar(150)
  email         String   @unique @db.VarChar(100)
  username      String   @unique @db.VarChar(80)
  phoneNumber   String?  @unique @map("phone_number") @db.VarChar(8)
  password      String
  role          Role
  status        Boolean  @default(true)
  hireDate      DateTime @map("hire_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions UserSession[]

  @@map("employee")
}

model Client {
  id               String   @id @default(uuid()) @db.Uuid
  firstName        String   @map("first_name") @db.VarChar(150)
  middleName       String?  @map("middle_name") @db.VarChar(150)
  surname          String?  @db.VarChar(150)
  secondSurname    String?  @map("second_surname") @db.VarChar(150)
  email            String?  @unique @db.VarChar(100)
  status           Boolean  @default(true)
  phoneNumber      String?  @unique @map("phone_number") @db.VarChar(8)
  dateRegistration DateTime @default(now()) @map("date_registration") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  reservations Reservation[]

  @@map("client")
}

model Reservation {
  id                  String              @id @default(uuid()) @db.Uuid
  clientId            String              @map("client_id") @db.Uuid
  reservationResource ReservationResource @map("reservation_resource")
  hour                DateTime            @db.Time(0)
  totalReservation    Decimal             @map("total_reservation") @db.Decimal(10, 2)
  reservedHours       Int                 @map("reserved_hours")
  status              ReservationStatus
  reservationDate     DateTime            @map("reservation_date") @db.Date
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  client   Client               @relation(fields: [clientId], references: [id])
  deposits ReservationDeposit[]

  @@map("reservation")
}

model ReservationDeposit {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("reservation_deposit")
}

model UserSession {
  id         String    @id @default(uuid())
  employeeId String    @db.Uuid
  tokenId    String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])

  @@map("user_session")
}
