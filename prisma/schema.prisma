// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMINISTRATOR
  ADMINISTRATOR
  COURT_MANAGER
  CLEANING_STAFF
  RECEPTIONIST
}

enum ReservationResource {
  CANCHA_1
  CANCHA_2
  SALON
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  FINALIZADA
}

model Employee {
  id            String   @id @default(uuid()) @db.Uuid
  firstName     String   @db.VarChar(150) @map("first_name")
  middleName    String   @db.VarChar(150) @map("middle_name")
  surname       String   @db.VarChar(150)
  secondSurname String   @db.VarChar(150) @map("second_surname")
  email         String   @unique @db.VarChar(100)
  username      String   @unique @db.VarChar(80)
  phoneNumber      String?  @unique @db.VarChar(8) @map("phone_number")
  password      String
  role          Role
  status        Boolean  @default(true)
  hireDate      DateTime @db.Date @map("hire_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("employee")
}

model Client {
  id               String   @id @default(uuid()) @db.Uuid
  firstName        String   @db.VarChar(150) @map("first_name")
  middleName       String?  @db.VarChar(150) @map("middle_name")
  surname          String?  @db.VarChar(150)
  secondSurname    String?  @db.VarChar(150) @map("second_surname")
  email            String?  @unique @db.VarChar(100)
  status           Boolean  @default(true)
  phoneNumber      String?  @unique @db.VarChar(8) @map("phone_number")
  dateRegistration DateTime @default(now()) @db.Date @map("date_registration")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  reservations Reservation[]

  @@map("client")
}

model Reservation {
  id                  String              @id @default(uuid()) @db.Uuid
  clientId            String              @db.Uuid @map("client_id")
  reservationResource ReservationResource @map("reservation_resource")
  hour                DateTime            @db.Time(0)
  totalReservation    Decimal             @db.Decimal(10, 2) @map("total_reservation")
  reservedHours       Int                 @map("reserved_hours")
  status              ReservationStatus
  reservationDate     DateTime            @db.Date @map("reservation_date")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  client   Client               @relation(fields: [clientId], references: [id])
  deposits ReservationDeposit[]

  @@map("reservation")
}

model ReservationDeposit {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @db.Uuid @map("reservation_id")
  amount        Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("reservation_deposit")
}